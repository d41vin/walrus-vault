# ===================================
# WalrusVault Inspector — Web App Environment Variables
# ===================================

# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Walrus Endpoints
NEXT_PUBLIC_WALRUS_AGGREGATOR=https://aggregator.walrus.wal.app
WALRUS_PUBLISHER=https://publisher.walrus.wal.app

# MemWal Relayer
NEXT_PUBLIC_MEMWAL_SERVER_URL=https://relayer.memwal.ai

# Note: MemWal credentials (delegate key + account ID) come from
# user input in the UI and are stored in localStorage only.
# They are NEVER persisted as server-side env vars.